{
  "name": "vue-sanitize",
  "version": "0.3.1",
  "description": "HTML sanitizer plugin for Vue 3, powered by sanitize-html.",
  "homepage": "https://github.com/daichirata/vue-sanitize",
  "type": "module",
  "main": "./dist/vue-sanitize.cjs",
  "module": "./dist/vue-sanitize.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vue-sanitize.umd.js",
  "jsdelivr": "./dist/vue-sanitize.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-sanitize.js",
      "require": "./dist/vue-sanitize.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-plugin",
    "sanitize",
    "sanitize-html",
    "xss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daichirata/vue-sanitize.git"
  },
  "author": "Daichi HIRATA <daichirata@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.2",
    "@typescript/typescript6": "^6.0.2",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
